# ─── Unified Prod Dockerfile untuk realtime-service ───────────────────────────────
# Build context: root project (agar proto/ tersedia untuk build.rs)
# Multi-stage: builder (compile) → runner (minimal image)

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM rust:latest AS builder

WORKDIR /app

# Install protoc untuk gRPC codegen (build.rs)
RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Install sqlx-cli untuk migrasi
RUN cargo install sqlx-cli --no-default-features --features postgres

# Proto dari root project (tersedia karena context = root)
COPY proto/ /proto/

# Source service
COPY realtime-service/ .
COPY shared-core/ /shared-core/

# SQLX_OFFLINE=true agar cargo build tidak butuh koneksi database saat image build
ENV SQLX_OFFLINE=true
RUN cargo build --release

# ── Stage 2: Runner (minimal) ─────────────────────────────────────────────────
FROM ubuntu:24.04

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates libpq5 && rm -rf /var/lib/apt/lists/* && apt-get clean

# Copy hanya binary, sqlx, migrations, dan entrypoint — TIDAK copy .env
COPY --from=builder /app/target/release/realtime-service .
COPY --from=builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx
COPY --from=builder /app/migrations ./migrations
COPY realtime-service/entrypoint.sh .
RUN chmod +x entrypoint.sh

EXPOSE 8001

# entrypoint.sh: sqlx migrate run && ./realtime-service
CMD ["./entrypoint.sh"]
