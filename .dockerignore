# Root .dockerignore — digunakan saat build context = root project
# (untuk rust-auth/Dockerfile.unified.dev dan rust-message/Dockerfile.unified.dev)

# Rust build artifacts (sangat besar, tidak dibutuhkan)
rust-auth/target/
rust-message/target/

# Node.js
frontend/node_modules/
frontend/.next/

# Go build cache
fiber-product/tmp/

# Git
.git/
.gitignore

# Env files (sensitive)
**/.env
**/.env.*
!frontend/.env.development
!frontend/.env.production

# Misc
**/.DS_Store
**/node_modules/
