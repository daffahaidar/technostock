# Root .dockerignore — digunakan saat build context = root project
# (untuk auth-service/Dockerfile.unified.dev dan realtime-service/Dockerfile.unified.dev)

# Rust build artifacts (sangat besar, tidak dibutuhkan)
auth-service/target/
grpc-service/target/
realtime-service/target/

# Tooling agent — isinya symlink, tar-writer Podman di Windows gagal
# encode reparse point Windows ("unknown file mode ?rw-rw-rw-").
.claude/
.agents/

# Node.js
frontend/node_modules/
frontend/.next/

# Go build cache
main-service/tmp/

# Git
.git/
.gitignore

# Env files (sensitive)
**/.env
**/.env.*
!frontend/.env.development
!frontend/.env.production

# Misc
**/.DS_Store
**/node_modules/
