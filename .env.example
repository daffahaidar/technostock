# ═══════════════════════════════════════════════════════════════════════════════
# Technorider — Environment Variables Reference
# Salin ke .env (jika diperlukan) atau konfigurasikan di docker-compose
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=technorider
# Host (dari container): postgres | Host (dari host machine): localhost:5433
DATABASE_URL=postgres://postgres:admin@postgres:5432/technorider

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=daffahaidarnz27

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=daffahaidar
RABBITMQ_PASS=daffahaidarnz27

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=daffahaidar
MINIO_SECRET_KEY=daffahaidarnz27
MINIO_BUCKET=technorider

# ─── Rust Auth Service ────────────────────────────────────────────────────────
RUST_AUTH_PORT=8000
RUST_AUTH_GRPC_PORT=50051
AUTH_GRPC_URL=rust-auth:50051   # internal | localhost:50051 (host)

# ─── Rust Message Service ─────────────────────────────────────────────────────
RUST_MESSAGE_PORT=8001

# ─── Fiber Product Service ────────────────────────────────────────────────────
FIBER_PRODUCT_PORT=8002
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_API_URL=ws://localhost:8001
NEXT_PUBLIC_GOLANG_API=http://localhost:8002
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side (dalam container)
SERVER_API_URL=http://rust-auth:8000

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth-callback?provider=google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth-callback?provider=github
