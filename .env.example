# ═══════════════════════════════════════════════════════════════════════════════
# Technostock — Environment Variables Reference
#
# File ini adalah REFERENSI, bukan file yang dibaca langsung oleh service.
# Salin blok yang relevan ke file .env masing-masing service:
#
#   auth-service/.env  grpc-service/.env  realtime-service/.env
#   main-service/.env  frontend/.env.development  frontend/.env.production
#
# Nilai host di bawah memakai nama service Docker (postgres, redis, dst.).
# Untuk menjalankan manual di host, ganti ke localhost — perhatikan Postgres
# dipetakan ke port 5433 di host, bukan 5432.
#
# Port HTTP/gRPC setiap service Rust di-hardcode di kode (8000, 8001, 8080,
# 50051) dan tidak bisa diubah lewat env. Hanya main-service yang membaca PORT.
# ═══════════════════════════════════════════════════════════════════════════════


# ═══ Dipakai bersama ═══════════════════════════════════════════════════════════

# Generate sekali, pakai nilai yang SAMA di auth-service, grpc-service, dan
# realtime-service. Frontend cukup public key-nya saja.
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Docker: @postgres:5432 | Host: @localhost:5433
DATABASE_URL=postgres://postgres:admin@postgres:5432/technostock

RUST_LOG=info


# ═══ auth-service/.env — HTTP :8000 ════════════════════════════════════════════
# Butuh: DATABASE_URL, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY (lihat blok di atas)
#
# Keenam variabel OAuth di bawah WAJIB diisi. auth-service panic saat startup
# bila salah satu kosong, walaupun provider tersebut tidak dipakai.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth-callback?provider=github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth-callback?provider=google


# ═══ grpc-service/.env — Gateway :8080 + gRPC UserService :50051 ═══════════════
# Butuh: DATABASE_URL, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY (lihat blok di atas)

# Target proxy /api/v1/auth/*
AUTH_SERVICE_URL=http://auth-service:8000
# Target proxy /api/v1/main/*  (prefix /api/v1/main di-rewrite jadi /api/v1)
MAIN_SERVICE_URL=http://main-service:8002
# Target bridge WebSocket /ws/*
REALTIME_SERVICE_WS_URL=ws://realtime-service:8001
# Target route fallback. Default http://localhost:3000 salah di dalam container
# karena menunjuk ke gateway itu sendiri.
FRONTEND_URL=http://frontend:3000


# ═══ realtime-service/.env — HTTP + WebSocket :8001 ════════════════════════════
# Fitur chat sedang ON-HOLD (fokus saat ini: user & subscription). Variabel
# RABBITMQ_* di bawah akan diganti konfigurasi Kafka saat dilanjutkan.
# Butuh: DATABASE_URL, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY (lihat blok di atas).
# JWT_PUBLIC_KEY harus persis sama dengan milik auth-service.
# JWT_PRIVATE_KEY tetap wajib diisi walau service ini hanya memverifikasi token.

# Menunjuk ke grpc-service, BUKAN auth-service — server gRPC dijalankan gateway.
AUTH_GRPC_URL=http://grpc-service:50051

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=daffahaidar
MINIO_SECRET_KEY=daffahaidarnz27
MINIO_BUCKET=technostock

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=daffahaidarnz27

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=daffahaidar
RABBITMQ_PASS=daffahaidarnz27


# ═══ main-service/.env — HTTP :8002 ════════════════════════════════════════════
# Butuh: DATABASE_URL (lihat blok di atas)

PORT=8002

# Tanpa skema http://. Menunjuk ke grpc-service, BUKAN auth-service.
AUTH_GRPC_URL=grpc-service:50051

# Wajib — service log.Fatal saat startup bila kosong.
# Ambil dari https://dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=


# ═══ frontend/.env.development dan frontend/.env.production ════════════════════

# Diakses dari browser, jadi selalu localhost meski frontend jalan di container.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_API_URL=ws://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL untuk fetch server-side (dari dalam container).
# SERVER_API_URL  -> langsung ke auth-service (route handler /api/auth/*)
# SERVER_GATEWAY_URL -> ke gateway (checkout & public pricing)
SERVER_API_URL=http://auth-service:8000
SERVER_GATEWAY_URL=http://grpc-service:8080

# Public key RS256 untuk verifikasi token di route handler /api/auth/*.
# Tanpa ini token hanya di-decode tanpa verifikasi tanda tangan.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Opsional — baseURL createAuthClient. Fallback: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Opsional — override base URL REST chat.
# Default diturunkan dari NEXT_PUBLIC_WS_API_URL (ws:// -> http://).
# Endpoint /api/v1/chat/* belum ter-route di gateway; sementara ini arahkan
# langsung ke realtime-service. Lihat docs/operations.md -> Isu yang Diketahui.
# NEXT_PUBLIC_MESSAGE_API_URL=http://localhost:8001


# ═══ Kredensial infrastruktur (dipakai file docker-compose) ════════════════════
# Hanya untuk development lokal — ganti seluruhnya sebelum deploy.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=technostock

# Kafka (SASL/PLAIN) hanya ada di docker-compose.dev.yml dan belum dipakai kode
# mana pun — kredensialnya inline di JAAS config compose, bukan dari file ini.
# Disiapkan untuk menggantikan RabbitMQ di realtime-service; RabbitMQ nantinya
# dipakai notification-service (belum dibuat).
# KAFKA_USER=daffahaidar
# KAFKA_PASSWORD=daffahaidarnz27
