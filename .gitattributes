# Paksa LF untuk semua file text.
# Wajib: repo ini di-develop di macOS (Docker) dan Windows (Podman), sedangkan
# script seperti entrypoint.sh dieksekusi di dalam container Linux. Checkout
# CRLF di Windows bikin shebang rusak → "bad interpreter: /bin/sh^M".
* text=auto eol=lf

# Script khusus Windows tetap CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
