# ─── Stage 1: Build the application ──────────────────────────────────────────
FROM node:lts-alpine AS builder

WORKDIR /app

# corepack membaca field "packageManager" di package.json, jadi versi pnpm di
# container selalu sama dengan yang dipakai di host.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Build the Next.js app (output: standalone in next.config.ts)
RUN pnpm build

# ─── Stage 2: Production runner ───────────────────────────────────────────────
# Output standalone sudah memuat dependensi runtime-nya sendiri, jadi stage ini
# tidak butuh package manager maupun node_modules terpisah.
FROM node:lts-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Create a non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
